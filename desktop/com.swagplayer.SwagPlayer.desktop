[Desktop Entry]
Actions=Cerrar;
Version=1.0
Type=Application
Name=SwagPlayer
Comment=Android gaming platform for Linux
Exec=@HOME@/.local/bin/swagplayer-iniciar
Icon=com.swagplayer.SwagPlayer
Terminal=false
Categories=Game;
StartupNotify=true
StartupWMClass=SwagPlayer

[Desktop Action Cerrar]
Name=Cerrar Swagplayer
Exec=@HOME@/.local/bin/cerrar-swagplayer
Icon=application-exit
