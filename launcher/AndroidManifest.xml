<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de inicio de ZYKRO (reemplaza a Nova Launcher), al estilo de BlueStacks 5. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.zykro.inicio">

    <!-- Para el menú «Desinstalar» de cada app. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Desde Android 11 hay que declarar qué apps se quieren ver: las que se pueden abrir. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/nombre"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".Inicio"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
