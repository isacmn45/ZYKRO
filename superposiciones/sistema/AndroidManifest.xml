<?xml version="1.0" encoding="utf-8"?>
<!-- Superposición (RRO) que hace compactos el centro de control y las notificaciones de Android
     (SystemUI). Va en /product/overlay de la imagen de Android (ver houdini/Dockerfile). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.zykro.superposicion.sistema">
    <overlay
        android:isStatic="true"
        android:priority="50"
        android:targetPackage="com.android.systemui" />
    <application
        android:hasCode="false"
        android:label="Centro de control compacto (ZYKRO)" />
</manifest>
