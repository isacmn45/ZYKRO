<?xml version="1.0" encoding="utf-8"?>
<!-- Superposición (RRO) que hace compacta la app de Configuración de Android: en una ventana de
     laptop se ve enorme. Va en /product/overlay de la imagen de Android (ver houdini/Dockerfile). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.zykro.ajustes.compactos">
    <overlay
        android:isStatic="true"
        android:priority="50"
        android:targetPackage="com.android.settings" />
    <application
        android:hasCode="false"
        android:label="Configuración compacta (ZYKRO)" />
</manifest>
