#!/usr/bin/python3
"""Escribir en el chat de los juegos de SwagPlayer con el teclado de la laptop.

SwagPlayer convierte cada tecla en un toque mapeado, así que en el chat de
Free Fire no se puede escribir. Este script vigila Android: mientras el juego
tiene abierto su cuadro de texto, toma el teclado en exclusiva (SwagPlayer deja
de recibirlo) y manda las letras directo a Android. Cuando el cuadro se cierra
(Enter o Esc) le devuelve el teclado a SwagPlayer.

Salida de emergencia: Alt o la tecla Windows devuelven el teclado al instante.
Lo inicia swagplayer-iniciar y se detiene solo al cerrar SwagPlayer.
"""
import fcntl
import os
import re
import select
import shlex
import struct
import subprocess
import threading
import time

C = 'redroid-redroid-1'
FOCO = re.compile(r'Focus (entering|leaving) (\w+) ')
EVIOCGRAB = 0x40044590
EVENTO = struct.Struct('llHHi')
EV_KEY = 1

# Distribución US (la de la laptop): código evdev -> (normal, con Shift)
LETRAS = {}
for fila, codigo in (('1234567890-=', 2), ('qwertyuiop[]', 16), ("asdfghjkl;'`", 30), ('zxcvbnm,./', 44)):
    for i, ch in enumerate(fila):
        LETRAS[codigo + i] = ch
LETRAS[43] = '\\'
CON_SHIFT = dict(zip("1234567890-=[];'`\\,./", '!@#$%^&*()_+{}:"~|<>?'))
ESPECIALES = {14: 'DEL', 28: 'ENTER', 96: 'ENTER', 1: 'BACK', 57: 'SPACE', 111: 'FORWARD_DEL',
              105: 'DPAD_LEFT', 106: 'DPAD_RIGHT', 103: 'DPAD_UP', 108: 'DPAD_DOWN',
              102: 'MOVE_HOME', 107: 'MOVE_END'}
SHIFT = {42, 54}
CAPS = 58
SALIDA = {56, 100, 125, 126}  # Alt y tecla Windows


class Android:
    """Una sola shell abierta dentro de Android para que cada tecla tarde poco."""

    def __init__(self):
        self.sh = subprocess.Popen(['docker', 'exec', '-i', C, 'sh'], stdin=subprocess.PIPE,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, text=True)

    def enviar(self, comando):
        self.sh.stdin.write(comando + '\n')
        self.sh.stdin.flush()

    def texto(self, ch):
        self.enviar('input text ' + shlex.quote(ch))

    def tecla(self, nombre):
        self.enviar('input keyevent ' + nombre)


def android(*args):
    return subprocess.run(['docker', 'exec', C, *args], capture_output=True, text=True, timeout=10).stdout


def es_cuadro_texto(ventana):
    """El cuadro de texto de Unity es una ventana aparte que pide el teclado
    siempre visible; la ventana normal del juego es BASE_APPLICATION."""
    partes = android('dumpsys', 'window', 'windows').split(f'Window{{{ventana} ', 1)
    if len(partes) < 2:
        return False
    bloque = partes[1][:3000]
    return 'BASE_APPLICATION' not in bloque and 'always_visible' in bloque


def ventana_con_foco():
    m = re.search(r'mCurrentFocus=Window\{(\w+) ', android('dumpsys', 'window'))
    return m.group(1) if m else None


def teclados():
    """Teclados reales (con letras y sin movimiento de mouse)."""
    encontrados = []
    for bloque in open('/proc/bus/input/devices').read().split('\n\n'):
        nombre = re.search(r'N: Name="(.*)"', bloque)
        evento = re.search(r'H: Handlers=.*\b(event\d+)', bloque)
        teclas = re.search(r'B: KEY=([0-9a-f ]+)', bloque)
        if not (nombre and evento and teclas) or 'SwagPlayer' in nombre.group(1) or 'B: REL=' in bloque:
            continue
        bits = int(teclas.group(1).replace(' ', ''), 16)
        if all(bits >> k & 1 for k in (16, 30, 44)):  # Q, A, Z
            encontrados.append('/dev/input/' + evento.group(1))
    return encontrados


class ModoEscribir:
    def __init__(self, android_sh):
        self.a = android_sh
        self.lock = threading.Lock()
        self.ventana = None
        self.fds = []
        self.shift = set()
        self.caps = False

    def activar(self, ventana):
        with self.lock:
            if self.fds:
                self.ventana = ventana
                return
            for ruta in teclados():
                try:
                    fd = os.open(ruta, os.O_RDONLY | os.O_NONBLOCK)
                    fcntl.ioctl(fd, EVIOCGRAB, 1)
                    self.fds.append(fd)
                except OSError:
                    pass
            if not self.fds:
                return
            self.ventana = ventana
            self.shift.clear()
        threading.Thread(target=self._leer, daemon=True).start()
        threading.Thread(target=self._vigilar, args=(ventana,), daemon=True).start()

    def desactivar(self, ventana=None):
        with self.lock:
            if ventana and ventana != self.ventana:
                return
            for fd in self.fds:
                try:
                    fcntl.ioctl(fd, EVIOCGRAB, 0)
                except OSError:
                    pass
                os.close(fd)
            self.fds = []
            self.ventana = None

    def _vigilar(self, ventana):
        # Por si Android no avisa que el cuadro se cerró.
        while True:
            time.sleep(1.5)
            with self.lock:
                if self.ventana != ventana:
                    return
            if ventana_con_foco() != ventana:
                self.desactivar(ventana)
                return

    def _leer(self):
        while True:
            with self.lock:
                fds = list(self.fds)
            if not fds:
                return
            try:
                listos, _, _ = select.select(fds, [], [], 0.5)
            except (OSError, ValueError):
                continue
            for fd in listos:
                try:
                    datos = os.read(fd, EVENTO.size * 64)
                except OSError:
                    continue
                for i in range(0, len(datos), EVENTO.size):
                    _, _, tipo, codigo, valor = EVENTO.unpack_from(datos, i)
                    if tipo == EV_KEY:
                        self._tecla(codigo, valor)

    def _tecla(self, codigo, valor):
        if codigo in SHIFT:
            (self.shift.add if valor else self.shift.discard)(codigo)
            return
        if valor == 0:  # soltar
            return
        if codigo in SALIDA:
            self.desactivar()
            return
        if codigo == CAPS and valor == 1:
            self.caps = not self.caps
            return
        if codigo in ESPECIALES:
            self.a.tecla(ESPECIALES[codigo])
        elif codigo in LETRAS:
            ch = LETRAS[codigo]
            mayus = bool(self.shift)
            if ch.isalpha():
                ch = ch.upper() if mayus != self.caps else ch
            elif mayus:
                ch = CON_SHIFT.get(ch, ch)
            self.a.texto(ch)


def main():
    modo = ModoEscribir(Android())
    log = subprocess.Popen(['docker', 'exec', C, 'logcat', '-b', 'events', '-s', 'input_focus', '-T', '1'],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    primera = True
    for linea in log.stdout:
        if primera:  # -T 1 repite el último evento viejo
            primera = False
            continue
        m = FOCO.search(linea)
        if not m:
            continue
        accion, ventana = m.groups()
        if accion == 'leaving':
            modo.desactivar(ventana)
        elif es_cuadro_texto(ventana):
            modo.activar(ventana)
        else:
            modo.desactivar()


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        pass
