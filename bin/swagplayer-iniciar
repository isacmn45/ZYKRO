#!/usr/bin/python3
"""Lanzador de SwagPlayer con nuestras mejoras.

- Precarga closefix.so para que SwagPlayer cierre sin colgarse.
- Oculta el teclado en pantalla de Android (teclado-android).
- Activa el modo escribir para el chat de los juegos (ff-escribir).
- Apaga Android al cerrar SwagPlayer.
"""
import os
import subprocess
import time
from pathlib import Path

C = 'redroid-redroid-1'
BIN = Path.home() / '.local/bin'
LIB = Path.home() / '.local/lib/swagplayer'


def detener_android():
    # Free Fire y Android corren en el contenedor; al cerrar SwagPlayer se apaga todo.
    try:
        subprocess.run(['docker', 'stop', '-t', '5', C],
                       timeout=30, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        pass


env = os.environ.copy()
fix = str(LIB / 'closefix.so')
env['LD_PRELOAD'] = fix + (':' + env['LD_PRELOAD'] if env.get('LD_PRELOAD') else '')
# Avoid direct DMA-BUF import while recovering the initial video frame.
env['SWAG_DMABUF_FORCE_CPU'] = '1'
started = time.time()
escribir = None
app = subprocess.Popen(['/usr/bin/swagplayer'], env=env)
status = Path('/tmp/swag_sockets/server.status')
for _ in range(120):
    if app.poll() is not None:
        break
    try:
        ready = status.stat().st_mtime >= started and 'capture session created' in status.read_text()
    except OSError:
        ready = False
    if ready:
        # Force a fresh composition after the capture listener is attached.
        try:
            subprocess.run(['docker', 'exec', C, 'sh', '-c',
                            'input keyevent 223; sleep 0.2; input keyevent 224'],
                           timeout=10, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired):
            pass
        # Teclado "físico" falso para que Android oculte el teclado en pantalla.
        try:
            subprocess.run([str(BIN / 'teclado-android'), 'ocultar'],
                           timeout=15, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired):
            pass
        # Escribir en el chat de los juegos con el teclado de la laptop.
        try:
            escribir = subprocess.Popen([str(BIN / 'ff-escribir')],
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass
        break
    time.sleep(0.5)
code = app.wait()
if escribir:
    escribir.terminate()
detener_android()
raise SystemExit(code)
